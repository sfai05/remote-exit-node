# Managed by Ansible. lan_v4 / lan_v6 are filled at runtime by exit-node-lan-guard.
table inet exit_node_guard
delete table inet exit_node_guard

table inet exit_node_guard {
    # Counts doctor probes: UDP payloads of 777 bytes, a size no WireGuard packet has.
    counter wg_probe {
    }

{% set static4 = lan_guard_static_ipv4 + lan_guard_extra_ipv4 %}
{% set static6 = lan_guard_static_ipv6 + lan_guard_extra_ipv6 %}
    set static_v4 {
        type ipv4_addr
        flags interval
        auto-merge
{% if static4 | length > 0 %}
        elements = { {{ static4 | join(', ') }} }
{% endif %}
    }

    set static_v6 {
        type ipv6_addr
        flags interval
        auto-merge
{% if static6 | length > 0 %}
        elements = { {{ static6 | join(', ') }} }
{% endif %}
    }

    set lan_v4 {
        type ipv4_addr
        flags interval
        auto-merge
    }

    set lan_v6 {
        type ipv6_addr
        flags interval
        auto-merge
    }
{% if lan_guard_block | bool and lan_guard_interfaces | length > 0 %}
{% set ifaces = '{ "' ~ (lan_guard_interfaces | join('", "')) ~ '" }' %}

    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname {{ ifaces }} ip daddr @static_v4 drop
        iifname {{ ifaces }} ip daddr @lan_v4 drop
        iifname {{ ifaces }} ip6 daddr @static_v6 drop
        iifname {{ ifaces }} ip6 daddr @lan_v6 drop
    }
{% endif %}
{% if enable_wireguard | bool %}

    chain input {
        type filter hook input priority filter; policy accept;
        udp dport {{ wireguard_port }} udp length 785 counter name "wg_probe"
    }
{% endif %}
}
