# Managed by Ansible. Loaded by wg-quick PostUp, removed by PostDown. LAN blocking lives in lan_guard.
table inet {{ wireguard_nft_table }}
delete table inet {{ wireguard_nft_table }}

table inet {{ wireguard_nft_table }} {
    chain forward {
        type filter hook forward priority filter; policy accept;
        iifname "{{ wireguard_interface }}" tcp flags & (syn | rst) == syn tcp option maxseg size set rt mtu
        oifname "{{ wireguard_interface }}" tcp flags & (syn | rst) == syn tcp option maxseg size set rt mtu
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "{{ node_wan_interface }}" ip saddr {{ wireguard_ipv4_network }} masquerade
{% if wireguard_ipv6_enabled | bool %}
        oifname "{{ node_wan_interface }}" ip6 saddr {{ wireguard_ipv6_network }} masquerade
{% endif %}
    }
}
