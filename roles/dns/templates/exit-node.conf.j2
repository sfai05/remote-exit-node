# Managed by Ansible. Recursive resolver reachable only from the WireGuard subnet,
# so lookups originate from this node's IP (correct geo-DNS, no DNS leak).
server:
    interface: 127.0.0.1
    interface: ::1
    interface: {{ wireguard_ipv4_server }}
{% if wireguard_ipv6_enabled | bool %}
    interface: {{ wireguard_ipv6_server }}
{% endif %}
    # wg0 may come up after unbound starts.
    ip-freebind: yes
    access-control: 0.0.0.0/0 refuse
    access-control: ::/0 refuse
    access-control: 127.0.0.0/8 allow
    access-control: ::1/128 allow
    access-control: {{ wireguard_ipv4_network }} allow
{% if wireguard_ipv6_enabled | bool %}
    access-control: {{ wireguard_ipv6_network }} allow
{% endif %}
    hide-identity: yes
    hide-version: yes
    qname-minimisation: yes
    prefetch: yes
    num-threads: 1
    msg-cache-size: 8m
    rrset-cache-size: 16m
