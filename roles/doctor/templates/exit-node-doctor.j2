#!/bin/bash
# Managed by Ansible. Node self-check; exit 0 = OK, 1 = warnings, 2 = failures.
# Usage: exit-node-doctor [--brief]   (--brief prints only WARN/FAIL)
#        exit-node-doctor probe-count (packets counted by the port-forward probe rule)
set -u
export LC_ALL=C

case "${1:-}" in
    probe-count)
        nft list counter inet exit_node_guard wg_probe 2>/dev/null \
            | awk '{for (i = 1; i < NF; i++) if ($i == "packets") {print $(i + 1); exit}}'
        exit 0 ;;
    "" | --brief) ;;
    *) echo "usage: $0 [--brief] | probe-count" >&2; exit 64 ;;
esac

brief=${1:-}
rc=0
ok()   { [ -n "$brief" ] || printf 'OK    %s\n' "$*"; }
info() { [ -n "$brief" ] || printf 'INFO  %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*"; [ "$rc" -ge 1 ] || rc=1; }
fail() { printf 'FAIL  %s\n' "$*"; rc=2; }
ago()  { local s=$1; if [ "$s" -lt 120 ]; then echo "${s}s"; elif [ "$s" -lt 7200 ]; then echo "$((s / 60))m"; else echo "$((s / 3600))h"; fi; }

for unit in {{ doctor_units | join(' ') }}; do
    if systemctl is-active --quiet "$unit"; then ok "$unit active"; else fail "$unit not active"; fi
done

failed=$(systemctl --failed --no-legend --plain | awk '{print $1}' | paste -sd' ' -)
if [ -z "$failed" ]; then ok "no failed systemd units"; else warn "failed units: $failed"; fi

{% if enable_tailscale | bool %}
state=$(tailscale status --json 2>/dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin).get("BackendState", ""))' 2>/dev/null)
if [ "$state" = Running ]; then ok "tailscaled logged in and running"; else fail "Tailscale state: ${state:-unknown}"; fi

{% endif %}
if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = yes ]; then ok "clock synchronized"; else warn "clock not NTP-synchronized"; fi

use=$(df --output=pcent / | tail -1 | tr -dc 0-9)
if [ "$use" -ge 95 ]; then fail "root disk ${use}% full"; elif [ "$use" -ge 85 ]; then warn "root disk ${use}% full"; else ok "root disk ${use}% used"; fi

pub4=$(curl -4 -fsS -m 10 https://ifconfig.me 2>/dev/null || true)
if [ -n "$pub4" ]; then ok "IPv4 internet"; info "public IPv4: $pub4"; else fail "no IPv4 internet"; fi
pub6=$(curl -6 -fsS -m 10 https://ifconfig.me 2>/dev/null || true)
info "public IPv6: ${pub6:-none}"

{% if enable_dns | bool and enable_wireguard | bool %}
if [ -n "$(dig +short +time=3 +tries=1 @127.0.0.1 example.com A 2>/dev/null)" ]; then ok "unbound resolves"; else fail "unbound does not resolve"; fi

{% endif %}
{% if enable_duckdns | bool %}
ddns=$(dig +short +time=3 +tries=1 @1.1.1.1 {{ duckdns_domain }}.duckdns.org A 2>/dev/null | tail -1)
if [ -n "$pub4" ] && [ "$ddns" = "$pub4" ]; then ok "DuckDNS {{ duckdns_domain }}.duckdns.org -> $ddns"
else warn "DuckDNS {{ duckdns_domain }}.duckdns.org -> ${ddns:-none}, public IPv4 ${pub4:-unknown} (updates every 5 min)"; fi

{% endif %}
if nft list table inet exit_node_guard >/dev/null 2>&1; then
    lan=$(for s in lan_v4 lan_v6; do nft list set inet exit_node_guard "$s"; done 2>/dev/null \
        | tr -d '\n' | grep -o 'elements = {[^}]*}' | sed 's/elements = { *//; s/ *}//' | tr -s ', \t' ' ' | paste -sd' ' -)
    ok "LAN guard loaded"
    info "LAN prefixes blocked for tunnel clients: ${lan:-none detected} (plus private ranges{{ ' and lan_guard_extra_*' if (lan_guard_extra_ipv4 + lan_guard_extra_ipv6) | length > 0 else '' }})"
else
    fail "LAN guard table missing"
fi

# lan_guard turns forwarding on only after its rules load; off = exit traffic stopped (fail-closed).
if [ "$(sysctl -n net.ipv4.ip_forward)" = 1 ]; then ok "IPv4 forwarding on"; else fail "IPv4 forwarding off: exit traffic stopped (check exit-node-lan-guard.service)"; fi
info "IPv6 forwarding: $( [ "$(sysctl -n net.ipv6.conf.all.forwarding)" = 1 ] && echo on || echo off)"

{% if enable_wireguard | bool %}
declare -A peer_name=(
{% for peer in wireguard_peers %}
    ["{{ peer.public_key }}"]="{{ peer.name }}"
{% endfor %}
)
expected=" {{ wireguard_peers | selectattr('expect_connected', 'defined') | selectattr('expect_connected') | map(attribute='name') | join(' ') }} "
now=$(date +%s)
ever=0
active=0
# Clients send keepalives every {{ wireguard_keepalive }}s and re-handshake every 2 min while up.
while read -r key ts; do
    name=${peer_name[$key]:-unknown}
    if [ "$ts" -eq 0 ]; then
        info "WireGuard $name: no handshake since the interface came up"
        state=never
    elif [ $((now - ts)) -le 180 ]; then
        ever=1; active=$((active + 1))
        info "WireGuard $name: connected (handshake $(ago $((now - ts))) ago)"
        state=active
    else
        ever=1
        info "WireGuard $name: idle, last handshake $(ago $((now - ts))) ago"
        state=idle
    fi
    case $expected in *" $name "*) [ "$state" = active ] || fail "WireGuard $name is expected to stay connected but is $state" ;; esac
done < <(wg show {{ wireguard_interface }} latest-handshakes 2>/dev/null)
if [ "$active" -gt 0 ]; then
    ok "WireGuard: $active client(s) connected now"
elif [ "$ever" = 1 ]; then
    info "WireGuard: no client connected right now"
else
    warn "WireGuard: no client has connected yet. Check the router forwards UDP {{ wireguard_port }} to this node (test: scripts/doctor.sh from outside this network)"
fi

{% endif %}
info "These are node-side checks; traffic through each tunnel is only proven by a client-side test."
exit "$rc"
