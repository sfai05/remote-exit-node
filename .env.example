# Optional: copy to .env, or .env.<node> for several nodes (gitignored), to pre-answer
# scripts/setup.sh [--env FILE]. Commented out = the script asks. Empty = "none" for optional items.
# Contains tokens once filled in: keep it out of git and back it up privately.
# The sudo password is never stored here; the script always asks for it.

# NODE=exit-node                     # inventory name + Tailscale hostname
# NODE_KIND=home                     # home (behind a home router) or cloud (VM with public IP)
# NODE_HOST=192.168.1.50             # IP or hostname, reachable during setup
# NODE_USER=admin                    # SSH/sudo user on the node (cloud: e.g. ubuntu)
# NODE_TIMEZONE=Europe/Berlin
# NODE_HOSTNAME=                     # set to rename the system hostname; empty = leave it
# SSH_KEY=~/.ssh/exit-node_ed25519

# DUCKDNS_DOMAIN=myexit              # empty = no DuckDNS
# WG_PEERS="unifi phone"             # one WireGuard client config per name; empty = no WireGuard
# WG_PORT=51822
# WG_SUBNET=10.88.0                  # /24 prefix, unique per node (10.88.0, 10.89.0, ...)
# WG_ENDPOINT=                       # only needed without DuckDNS (cloud: the public IP)

# TAILSCALE_AUTHKEY=                 # tskey-auth-...; empty = log in manually / already joined
# DUCKDNS_TOKEN=
# HEARTBEAT_URL=                     # e.g. https://hc-ping.com/<uuid>; empty = none
